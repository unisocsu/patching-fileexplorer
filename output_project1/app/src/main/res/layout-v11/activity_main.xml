<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/focusAnchor"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="1px"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/nav_bar_bg"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/btnBack"
            android:background="@drawable/icon_btn_bg"
            android:focusable="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="חזרה"/>
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/btnForward"
            android:background="@drawable/icon_btn_bg"
            android:focusable="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_forward"
            android:contentDescription="קדימה"/>
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/btnHome"
            android:background="@drawable/icon_btn_bg"
            android:focusable="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_home"
            android:contentDescription="בית"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_primary"
            android:ellipsize="start"
            android:layout_gravity="center_vertical"
            android:id="@+id/breadcrumbText"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"/>
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/btnMore"
            android:background="@drawable/icon_btn_bg"
            android:focusable="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_more"
            android:contentDescription="עוד אפשרויות"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/selectionBar"
        android:background="@drawable/selection_bar_bg"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/btnClearSelection"
            android:background="@drawable/icon_btn_bg"
            android:focusable="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_close"
            android:contentDescription="בטל"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_gravity="center_vertical"
            android:id="@+id/selectionCount"
            android:paddingLeft="8dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/btnSelectAll"
            android:background="@drawable/icon_btn_bg"
            android:focusable="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_select_all"
            android:contentDescription="הכל"/>
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/btnCopy"
            android:background="@drawable/icon_btn_bg"
            android:focusable="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_copy"
            android:contentDescription="העתק"/>
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/btnCut"
            android:background="@drawable/icon_btn_bg"
            android:focusable="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_cut"
            android:contentDescription="גזור"/>
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/btnPaste"
            android:background="@drawable/icon_btn_bg"
            android:focusable="true"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_paste"
            android:contentDescription="הדבק"/>
        <ImageButton
            android:layout_gravity="center_vertical"
            android:id="@+id/btnDelete"
            android:background="@drawable/icon_btn_bg"
            android:focusable="true"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_delete"
            android:contentDescription="מחק"/>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/listView"
            android:paddingTop="6dp"
            android:paddingBottom="72dp"
            android:focusable="false"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:listSelector="@android:color/transparent"
            android:divider="@null"
            android:dividerHeight="0dp"/>
        <GridView
            android:gravity="center"
            android:id="@+id/gridView"
            android:paddingLeft="6dp"
            android:paddingTop="6dp"
            android:paddingRight="6dp"
            android:paddingBottom="72dp"
            android:focusable="false"
            android:visibility="gone"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:listSelector="@android:color/transparent"
            android:horizontalSpacing="2dp"
            android:verticalSpacing="2dp"
            android:stretchMode="columnWidth"
            android:columnWidth="84dp"
            android:numColumns="auto_fit"/>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/progressBar"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/emptyView"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_folder"
                android:contentDescription="ריק"
                android:alpha="0.3"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/empty_folder"/>
        </LinearLayout>
        <ImageButton
            android:layout_gravity="end|bottom"
            android:id="@+id/fabAdd"
            android:background="@drawable/fab_bg"
            android:focusable="true"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_margin="16dp"
            android:src="@drawable/ic_add"
            android:contentDescription="הוסף"/>
    </FrameLayout>
</LinearLayout>
